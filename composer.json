{
    "name": "raymondoor/r3t",
    "description": "A PHP data migration tool.",
    "version": "0.5.1",
    "type": "library",
    "keywords": ["R3T", "migration", "data", "transfer", "database", "sql"],
    "time": "2026-10-07",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "R3T\\": "app/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "symfony/var-dumper": "^6.4",
        "rector/rector": "^2.7",
        "fakerphp/faker": "^1.24"
    },
    "autoload-dev": {
        "psr-4": {
            "R3T\\Test\\Unit\\": "test/Unit/"
        }
    }
}
