{
    "name": "raymondoor/datatransfer",
    "description": "A PHP data migration tool.",
    "version": "0.2.0",
    "type": "library",
    "keywords": ["Datatransfer", "migration"],
    "time": "2026-09-28",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "DataTransfer\\": "app/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "symfony/var-dumper": "^6.4",
        "rector/rector": "^2.6",
        "fakerphp/faker": "^1.24"
    },
    "autoload-dev": {
        "psr-4": {
            "DataTransfer\\Test\\Unit\\": "test/Unit/"
        }
    }
}
